# Variables que necesita Stockdex para funcionar.
#
# Copia este archivo como `.env` para desarrollo local, o carga estos mismos
# nombres como "variables de entorno" / "secrets" en el hosting donde publiques.
# Nunca subas el `.env` real al repositorio: contiene la llave de servicio.

# ── Supabase ────────────────────────────────────────────────────────────────
# Están en el panel de Supabase → Project Settings → API.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Llave de servicio: solo se usa en el servidor y salta todas las reglas de
# seguridad de la base. No la pongas nunca en una variable VITE_*.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Las mismas dos primeras, con prefijo VITE_, para el cliente.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_PROJECT_ID=tu-proyecto

# ── Área privada ────────────────────────────────────────────────────────────
# PIN que abre /agregar.
ADMIN_PIN=2703
# Cadena secreta larga (mínimo 32 caracteres) con la que se firma la cookie de
# sesión del área privada. Inventa una y no la compartas.
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
